+/* Temporary Linux/POSIX debug logger for the Issue 970 FPA walkthrough. */
+#include "flowlog.h"
+#ifdef X264_FLOW_TRACE
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <pthread.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#include <time.h>
+
+static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+static FILE *output;
+static int attempted;
+static unsigned long long event_id;
+
+void x264_flow_log( const char *component, const char *file, int line,
+                    const char *format, ... )
+{
+    pthread_mutex_lock( &lock );
+    if( !attempted )
+    {
+        attempted = 1;
+        const char *path = getenv( "X264_FLOW_LOG" );
+        if( path && *path )
+        {
+            output = fopen( path, "w" );
+            if( !output )
+                fprintf( stderr, "x264: cannot open flow log %s\n", path );
+        }
+    }
+    if( output )
+    {
+        struct timespec now;
+        struct tm wall;
+        char timestamp[32];
+        clock_gettime( CLOCK_REALTIME, &now );
+        localtime_r( &now.tv_sec, &wall );
+        strftime( timestamp, sizeof(timestamp), "%Y-%m-%d %H:%M:%S", &wall );
+        /* Component is a logical lane; only tid identifies the OS thread. */
+        fprintf( output, "[event=%06llu] %s.%06ld [thread id=%ld component=%s] %s:%d ",
+                 ++event_id, timestamp, now.tv_nsec / 1000, syscall(SYS_gettid),
+                 component, file, line );
+        va_list args;
+        va_start( args, format );
+        vfprintf( output, format, args );
+        va_end( args );
+        fputc( '\n', output );
+        fflush( output );
+    }
+    pthread_mutex_unlock( &lock );
+}
+
+void x264_flow_bytes( const char *component, const char *file, int line,
+                      const char *label, const void *data, int size )
+{
+    const unsigned char *bytes = data;
+    char hex[32 * 3 + 1];
+    int shown = size < 32 ? size : 32;
+    hex[0] = 0;
+    for( int i = 0; i < shown; i++ )
+        snprintf( hex + 3*i, sizeof(hex) - 3*i, "%02x ", bytes[i] );
+    x264_flow_log( component, file, line, "[BYTES stage=%s] size=%d shown=%d hex=%s",
+                   label, size, shown, hex );
+}
+#endif
