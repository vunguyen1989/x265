{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "x264: Issue 970 - 1 frame FPA flow",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/x264-debug/x264",
            "cwd": "${workspaceFolder}",
            "args": [
                "--demuxer",
                "y4m",
                "--frames",
                "1",
                "--preset",
                "ultrafast",
                "--tune",
                "zerolatency",
                "--qp",
                "28",
                "--threads",
                "1",
                "--lookahead-threads",
                "1",
                "--bframes",
                "0",
                "--keyint",
                "24",
                "--min-keyint",
                "24",
                "--scenecut",
                "0",
                "--frame-packing",
                "3",
                "--no-progress",
                "-o",
                "${workspaceFolder}/issues/970_worklog/step2/2.1.1_launch.h264",
                "${workspaceFolder}/issues/970_worklog/step1/1.3.1_sbs-test.y4m"
            ],
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "stopAtEntry": true,
            "externalConsole": false,
            "setupCommands": [
                {
                    "text": "set disable-randomization off"
                }
            ],
            "miDebuggerArgs": "-nx",
            "environment": [
                {
                    "name": "X264_FLOW_LOG",
                    "value": "${workspaceFolder}/x264.log"
                }
            ],
            "sourceFileMap": {
                "../../x264": "${workspaceFolder}/x264"
            }
        }
    ]
}
